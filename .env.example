# Public settings only. Enter secrets in the launcher's masked prompt or process environment.
# Do not put OPENAI_API_KEY, CLOUDFLARE_API_TOKEN, BLOB_READ_WRITE_TOKEN, or BACKEND_ACCESS_TOKEN in this file or in .env.
# Public HTTPS origin of the deployed backend, without a trailing path.
# Leave blank on Vercel (auto-detected) or when using Start-Locket-Backend.cmd (starts a temporary HTTPS tunnel).
PUBLIC_BASE_URL=
# auto (uses Cloudflare if CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN are set, else OpenAI), cloudflare, or openai
IMAGE_PROVIDER=auto
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
PORT=8787
HOST=127.0.0.1
DATA_DIR=./data/generated
INPUT_IMAGE_HOSTS=firebasestorage.googleapis.com,storage.googleapis.com,cdn.locketcamera.com
IMAGE_TTL_SECONDS=900
RATE_LIMIT_PER_MINUTE=3
MAX_CONCURRENT=1
DOWNLOAD_TIMEOUT_MS=8000
PROVIDER_TIMEOUT_MS=32000
MAX_IMAGE_BYTES=10485760

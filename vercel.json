{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/health", "destination": "/api/index?__path=/health" },
    { "source": "/v1/images/edit", "destination": "/api/index?__path=/v1/images/edit" },
    { "source": "/v1/images/compose", "destination": "/api/index?__path=/v1/images/compose" },
    { "source": "/images/:file", "destination": "/api/index?__path=/images/:file" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "assets/filters/**",
      "excludeFiles": "{test/**,test_python/**,tools/**,references/**,scripts/**,module/**}"
    }
  }
}
